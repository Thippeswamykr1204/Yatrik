# Docker Compose configuration. Copy to a new file such as .env.compose, never over an existing secret file.
# Compose requires explicit secrets; empty values intentionally fail closed.
APP_ENV=development
MONGO_INITDB_ROOT_USERNAME=yatrik
MONGO_INITDB_ROOT_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=
GEMINI_API_KEY=

FRONTEND_URL=https://yatrick.vercel.app
# Comma-separated exact origins. Production should be your Vercel URL(s).
FRONTEND_URLS=https://yatrick.vercel.app
# Backward-compatible production fallback.
FRONTEND_URL_PROD=
# Local: lax. Vercel -> Render production: none + secure.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Leave empty for cross-domain Vercel -> Render cookies.
COOKIE_DOMAIN=
# Configure only for a known, controlled reverse-proxy chain.
TRUST_PROXY=0
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1

# Frontend build-time configuration.
NEXT_PUBLIC_SITE_URL=https://yatrick.vercel.app
# Browser API origin. Local: http://localhost:5000. Production: your Render API URL.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional Next server rewrite target for Docker; Vercel can leave this empty.
API_INTERNAL_URL=http://api:5000

# Optional monitoring.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
