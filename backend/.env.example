# Local development: copy to backend/.env.local and replace the blank credentials.
# Production: inject variables through your secret manager, not this file.
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/yatrik
REDIS_URL=redis://127.0.0.1:6379
# Generate EACH secret independently: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
GEMINI_API_KEY=
FRONTEND_URL=http://localhost:3000
# Comma-separated exact origins. Local can use http://localhost:3000; production can use
# your Vercel URL and custom frontend URL. No paths or trailing slashes.
FRONTEND_URLS=http://localhost:3000
# Backward-compatible production fallback when FRONTEND_URLS is not set.
# FRONTEND_URL_PROD=https://your-project.vercel.app
# Local: lax. Vercel -> Render cross-site production: none + true.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Leave empty for Vercel -> Render. A cookie cannot be shared with a Vercel domain.
COOKIE_DOMAIN=
# 0 when directly reachable; 1 only behind one trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AI_RATE_LIMIT_MAX_REQUESTS=5
# Optional; omit entirely to disable telemetry.
# SENTRY_DSN=https://public-key@sentry.example.com/project-id

# Root Docker Compose also requires these injected values (no credential defaults).
# Use URL-safe hexadecimal passwords, since Compose embeds them in connection URLs.
# MONGO_INITDB_ROOT_USERNAME=yatrik
# MONGO_INITDB_ROOT_PASSWORD=
# REDIS_PASSWORD=
# APP_ENV=development
# NEXT_PUBLIC_API_URL=
# API_INTERNAL_URL=http://api:5000
# Keep NEXT_PUBLIC_API_URL blank for same-origin /api requests through the web service.
# Production Compose: APP_ENV=production, FRONTEND_URLS=https://your-project.vercel.app,
# COOKIE_SAME_SITE=none, COOKIE_SECURE=true, and TLS at a trusted reverse proxy.
# Public/internal API URLs are frontend BUILD args.
