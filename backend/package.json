{
  "name": "ai-travel-planner-backend",
  "version": "1.0.0",
  "description": "Production-grade AI Travel Planner backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/generation.worker.js",
    "lint": "eslint src tests scripts --ext .ts --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "worker:generation": "tsx src/workers/generation.worker.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check:duplicate-emails": "tsx scripts/reportDuplicateEmails.ts",
    "migrate:trip-cost-fields": "tsx scripts/renameTripCostFieldsToINR.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "travel",
    "ai",
    "planner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@sentry/node": "^10.74.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.56.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.1.1",
    "supertest": "^7.1.4",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "mongodb-memory-server@10.2.0": true
  }
}
