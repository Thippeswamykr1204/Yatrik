# Public canonical URL used for SEO. Replace for your deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser API origin. Local: http://localhost:5000. Production: your Render API URL.
# Do not include a trailing slash or /api; the client adds /api.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional server-side Next rewrite target. Needed for same-origin Docker deployments.
# Vercel can leave this empty when NEXT_PUBLIC_API_URL points to Render.
API_INTERNAL_URL=http://localhost:5000

# Optional monitoring; never put server credentials in NEXT_PUBLIC variables.
NEXT_PUBLIC_SENTRY_DSN=
